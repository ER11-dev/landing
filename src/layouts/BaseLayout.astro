---
import "../styles/global.css";
import "../styles/review.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialImage = new URL("/graphics/proof-assembly.webp", siteOrigin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e8" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ER11" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="ER11 production proof collage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <link rel="icon" href="/er11-logo.svg" type="image/svg+xml" />
  </head>
  <body>
    <!--
      THESIS: Three production layers register into one dependable product; refuse the generic SaaS hero and agency card wall.
      OWN-WORLD: Proof-paper white, dense black, process cyan/magenta/yellow, square proof sheets, crop marks, ledgers, and one circular seal action.
      STORY: Recognize the demo-to-production gap, inspect how the team closes it, choose a scoped engagement, and continue on Upwork.
      FIRST VIEWPORT: A narrow proof index frames a compressed six-line headline; a large annotated product proof fills the center-right; the Upwork action overlaps its lower edge.
      FORM: “The Press Check,” grounded direction 5 of 7; seed 9a4ba743; approved comp B, “Proof Desk.”
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to the page</a>
    <slot />
    <script src="../scripts/site.js"></script>
  </body>
</html>
