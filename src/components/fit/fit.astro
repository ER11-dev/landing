---
import "./fit.module.css";

const goodFit = [
  "A working prototype.",
  "One critical flow to harden.",
  "Senior owners working together.",
];

const poorFit = [
  "A pitch before product context.",
  "Three isolated executors.",
  "A fixed bid before we inspect the critical flow.",
];
---

<section class="fit" aria-labelledby="fit-title">
  <div class="fit__masthead">
    <span>Fit check</span><h2 id="fit-title">Know the fit before the scope.</h2>
  </div>
  <div class="fit__columns">
    <section class="fit__column fit__column--good">
      <header><b>01</b><h3>Likely a fit</h3></header>
      <ul>
        {
          goodFit.map((item, index) => (
            <li>
              <>
                <b>0{index + 1}</b>
                <span>{item}</span>
              </>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="fit__column fit__column--bad">
      <header><b>02</b><h3>Probably not</h3></header>
      <ul>
        {
          poorFit.map((item, index) => (
            <li>
              <>
                <b>0{index + 1}</b>
                <span>{item}</span>
              </>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>
