---
import ArrowIcon from "../arrow-icon/arrow-icon.astro";
import "./team.module.css";

const roles = [
  {
    number: "01",
    role: "Product / UX",
    copy: "Frames the problem, reduces scope ambiguity, designs the flow, and keeps product decisions visible.",
    className: "magenta",
    attribution: "Alexander Tishchenko",
    resources: [
      { label: "Portfolio", href: "https://ceofigma.vercel.app/" },
      { label: "Behance", href: "https://www.behance.net/vaipll" },
    ],
  },
  {
    number: "02",
    role: "Frontend",
    copy: "Turns the product model into a fast, accessible, maintainable interface that survives real states.",
    className: "cyan",
    attribution: null,
    resources: [{ label: "ER11 source", href: "https://github.com/ER11-dev" }],
  },
  {
    number: "03",
    role: "Backend",
    copy: "Builds dependable services, data flows, permissions, and operations behind the interface.",
    className: "yellow",
    attribution: null,
    resources: [],
  },
];

interface Props {
  actionHref?: string;
  externalLinks?: boolean;
}

const { actionHref = "#contact", externalLinks = true } = Astro.props;
---

<section class="team" id="team" aria-labelledby="team-title" data-index-section>
  <div class="section-heading section-heading--team">
    <span class="section-heading__number">05</span>
    <h2 id="team-title">Three accountable roles. One product path.</h2>
    <p>
      Product decisions, interface quality, and backend reliability stay in one
      conversation. Alexander’s public work supports Product / UX. Frontend and
      Backend are presented by the responsibilities they carry in delivery.
    </p>
  </div>
  <figure class="team__art">
    <img
      src="/graphics/team-proof-table.webp"
      alt="Magenta product flows, cyan interface layers, and yellow backend maps converging on one shared registration target."
      width="1693"
      height="929"
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      <span>Product / UX</span><span>Frontend</span><span>Backend</span>
    </figcaption>
  </figure>
  <div class="team__plate">
    {
      roles.map(({ number, role, copy, className, attribution, resources }) => (
        <article>
          <div class={`team__plate-mark team__plate-mark--${className}`}>
            <>
              <b>{number}</b>
              <span>Accountable role</span>
            </>
          </div>
          <h3>{role}</h3>
          <p>{copy}</p>
          {attribution && (
            <p class="team__attribution">
              <span>Verified attribution</span>
              <b>{attribution}</b>
            </p>
          )}
          <div class="team__plate-actions">
            {externalLinks && resources.length > 0 ? (
              resources.map(({ label, href }) => (
                <a href={href} target="_blank" rel="noreferrer">
                  {label}
                  <ArrowIcon />
                </a>
              ))
            ) : (
              <a href={actionHref}>
                {externalLinks ? `Discuss ${role} proof` : "Continue in Upwork"}
                <ArrowIcon />
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
