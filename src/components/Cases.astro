---
import ArrowIcon from "./ArrowIcon.astro";

const cases = [
  {
    number: "01",
    type: "B2B CRM · Product / UX",
    title: "Lead operations desk",
    copy: "A complete interface design cycle for a sales team managing high-volume lead operations and handoffs.",
    evidence: [
      "Workflow architecture",
      "Complex operational UI",
      "Published case study",
    ],
    href: "https://ceofigma.vercel.app/case-siakera.html",
    action: "Open case study",
    className: "case-row--magenta",
  },
  {
    number: "02",
    type: "Fintech · Product / UX",
    title: "RePay",
    copy: "A high-risk payments landing and private management interface designed for real client operations.",
    evidence: ["Product design", "Fintech interface", "Live public resource"],
    href: "https://repay.ws/",
    action: "Open RePay",
    className: "case-row--cyan",
  },
  {
    number: "03",
    type: "Agency · UI/UX collaboration",
    title: "AGC Burya",
    copy: "A published agency interface collaboration covering visual direction, information structure, and final UI.",
    evidence: [
      "Interface architecture",
      "Team collaboration",
      "Public Behance case",
    ],
    href: "https://www.behance.net/gallery/162252379/AGC-BURYA-UIUX-DESIGN",
    action: "Open Behance case",
    className: "case-row--yellow",
  },
];

interface Props {
  externalLinks?: boolean;
}

const { externalLinks = true } = Astro.props;
---

<section
  class="cases"
  id="cases"
  aria-labelledby="cases-title"
  data-index-section
>
  <div class="cases__masthead">
    <span>02</span>
    <h2 id="cases-title">Selected work, not borrowed claims.</h2>
    <p>
      These public examples belong to our Product / UX lead. Engineering proof
      is discussed against the scope, codebase, and release path of your
      project.
    </p>
  </div>
  <div class="case-ledger">
    {
      cases.map(
        ({ number, type, title, copy, evidence, href, action, className }) => (
          <article class:list={["case-row", className]}>
            <header>
              <>
                <b>{number}</b>
                <span>{type}</span>
              </>
            </header>
            <div class="case-row__body">
              <>
                <h3>{title}</h3>
                <p>{copy}</p>
              </>
            </div>
            <ul>
              {evidence.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {externalLinks ? (
              <a href={href} target="_blank" rel="noreferrer">
                {action}
                <ArrowIcon />
              </a>
            ) : (
              <span class="case-row__source">
                Source available in Upwork
                <ArrowIcon />
              </span>
            )}
          </article>
        ),
      )
    }
  </div>
</section>
