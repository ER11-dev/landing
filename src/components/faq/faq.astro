---
import "./faq.module.css";

const questions = [
  {
    question: "Do all three people need to join every project?",
    answer:
      "No. The scope should use only the ownership it needs. A readiness sprint may involve all three briefly; a focused frontend delivery may not.",
  },
  {
    question: "Will you rewrite an existing backend in Go?",
    answer:
      "Not by default. Go is a confirmed team capability, not a reason to replace a backend that already serves the product well.",
  },
  {
    question: "Can you work from a rapidly assembled codebase?",
    answer:
      "Yes. The first step is to understand the product and technical risk, then preserve what works and strengthen the path that real users depend on.",
  },
  {
    question: "Where does the project contract happen?",
    answer:
      "For prospects coming through Upwork, the conversation and contract stay on the team's single Upwork account.",
  },
];
---

<section class="faq" aria-labelledby="faq-title">
  <div class="section-heading section-heading--compact section-heading--faq">
    <span class="section-heading__number">Q/A</span>
    <h2 id="faq-title">What clients ask before scope.</h2>
  </div>
  <div class="faq__list">
    {
      questions.map(({ question, answer }) => (
        <details>
          <>
            <summary>
              {question}
              <span />
            </summary>
            <p>{answer}</p>
          </>
        </details>
      ))
    }
  </div>
</section>
