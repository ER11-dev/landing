---
import ArrowIcon from "../arrow-icon/arrow-icon.astro";
import type { ProjectSummary } from "../../lib/content/domain";
import "./cases.module.css";

interface Props {
  projects: ProjectSummary[];
}

const { projects } = Astro.props;
---

<section
  class="cases"
  id="cases"
  aria-labelledby="cases-title"
  data-index-section
>
  <div class="cases__masthead">
    <span>02</span>
    <h2 id="cases-title">Selected work, not borrowed claims.</h2>
    <p>
      These public examples belong to our Product / UX lead. Engineering proof
      is discussed against the scope, codebase, and release path of your
      project.
    </p>
  </div>
  <div class="cases__ledger">
    {
      projects.map((project) => (
        <article class:list={["cases__row", `cases__row--${project.accent}`]}>
          <header>
            <>
              <b>{project.number}</b>
              <span>{project.type}</span>
            </>
          </header>
          <div class="cases__row-body">
            <>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
            </>
          </div>
          <ul>
            {project.evidence.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a href={project.detailPath}>
            Inspect project
            <ArrowIcon />
          </a>
        </article>
      ))
    }
  </div>
</section>
