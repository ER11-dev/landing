---
import ArrowIcon from "../arrow-icon/arrow-icon.astro";
import "./final-proof.module.css";
---

<section
  class="final-proof"
  id="upwork"
  aria-labelledby="final-title"
  data-index-section
>
  <img
    class="final-proof__graphic"
    src="/graphics/release-mark.webp"
    alt="A CMY registration target converging into one black release arrow."
    width="1254"
    height="1254"
    loading="lazy"
    decoding="async"
  />
  <h2 id="final-title">Start with the flow that cannot fail.</h2>
  <a
    class="final-proof__action"
    href="https://www.upwork.com/"
    aria-describedby="upwork-note"
  >
    <span>Discuss your prototype on Upwork</span><ArrowIcon />
  </a>
  <p class="final-proof__link-note" id="upwork-note">
    Temporary destination: replace with the single Upwork account URL before
    publishing.
  </p>
  <div class="final-proof__footer">
    <span>3 senior owners</span><span>1 Upwork account</span><span
      >1 product conversation</span
    >
  </div>
</section>
