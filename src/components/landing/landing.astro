---
import ProofIndex from "../proof-index/proof-index.astro";
import Hero from "../hero/hero.astro";
import RoleBands from "../role-bands/role-bands.astro";
import Partners from "../partners/partners.astro";
import Cases from "../cases/cases.astro";
import Readiness from "../readiness/readiness.astro";
import Offers from "../offers/offers.astro";
import Team from "../team/team.astro";
import TechnologyPress from "../technology-press/technology-press.astro";
import Fit from "../fit/fit.astro";
import Faq from "../faq/faq.astro";
import Contact from "../contact/contact.astro";
import type { ProjectSummary } from "../../lib/content/domain";
import { UPWORK_DESTINATION_URL } from "../../config/links";
import "../../styles/composition.css";

interface Props {
  upworkSafe?: boolean;
  projects: ProjectSummary[];
}

const { upworkSafe = false, projects } = Astro.props;
const actionHref = upworkSafe ? UPWORK_DESTINATION_URL : "#contact";
---

<ProofIndex
  contactHref={actionHref}
  contactLabel={upworkSafe ? "Back to Upwork" : "Start a project"}
/>
<main id="main">
  <Hero
    primaryHref={actionHref}
    primaryLabel={upworkSafe ? "Continue on Upwork" : "Start a project"}
  />
  <RoleBands />
  <Partners externalLinks={!upworkSafe} />
  <Cases {projects} />
  <Readiness />
  <Offers
    actionHref={actionHref}
    actionLabel={upworkSafe ? "Continue on Upwork" : "Discuss this scope"}
  />
  <Team actionHref={actionHref} externalLinks={!upworkSafe} />
  <TechnologyPress />
  <Fit />
  <Faq />
  <Contact actionHref={actionHref} mode={upworkSafe ? "upwork" : "direct"} />
</main>
