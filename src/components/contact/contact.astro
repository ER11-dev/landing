---
import ArrowIcon from "../arrow-icon/arrow-icon.astro";
import "./contact.module.css";

interface Props {
  actionHref?: string;
  mode?: "direct" | "upwork";
}

const { actionHref = "#contact", mode = "direct" } = Astro.props;
const isUpwork = mode === "upwork";
---

<section
  class:list={["contact", isUpwork && "contact--upwork"]}
  id="contact"
  aria-labelledby="contact-title"
  data-index-section
>
  <div class="contact__heading">
    <span>07</span>
    <h2 id="contact-title">
      {
        isUpwork
          ? "Continue where the conversation started."
          : "Bring us the flow that cannot fail."
      }
    </h2>
    <p>
      {
        isUpwork
          ? "For prospects arriving from Upwork, messages and the contract stay on Upwork. Return to the conversation where you received this link."
          : "Send the current product, the fragile path, and what needs to become true. We will reply with the smallest useful next step."
      }
    </p>
  </div>

  {
    isUpwork ? (
      <div class="contact__upwork-action">
        <a href={actionHref}>
          Open your Upwork messages <ArrowIcon />
        </a>
        <p>
          No off-platform contact details or lead form are shown on this route.
        </p>
      </div>
    ) : (
      <div class="contact__body">
        <form
          class="contact__form"
          data-contact-form
        >
          <label>
            <span>Your name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Work email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            <span>Product stage</span>
            <select name="stage" required>
              <option value="">Choose one</option>
              <option>Working prototype</option>
              <option>Existing product</option>
              <option>New build</option>
            </select>
          </label>
          <label class="contact__form-brief">
            <span>What needs to hold up?</span>
            <textarea name="brief" rows="6" required />
          </label>
          <button type="submit" aria-describedby="contact-form-status">
            Compose enquiry <ArrowIcon />
          </button>
          <p
            class="contact__form-status"
            id="contact-form-status"
            data-contact-status
            aria-live="polite"
          >
            Submit your enquiry. We will reply shortly.
          </p>

        </form>

        <aside class="contact__channels" aria-label="Direct contact options">
          <h3>Verified contact routes</h3>
          <a href="mailto:vaiplimish@gmail.com">
            <>
              <span>Email</span>
              <b>vaiplimish@gmail.com</b>
              <ArrowIcon />
            </>
          </a>
          <a href="https://t.me/ceosuk" target="_blank" rel="noreferrer">
            <>
              <span>Telegram</span>
              <b>@ceosuk</b>
              <ArrowIcon />
            </>
          </a>
          <a
            href="https://ceofigma.vercel.app/"
            target="_blank"
            rel="noreferrer"
          >
            <>
              <span>Product / UX lead</span>
              <b>Alexander Tishchenko</b>
              <ArrowIcon />
            </>
          </a>
        </aside>
      </div>
    )
  }

  <div class="contact__legal">
    <details id="privacy">
      <summary>Privacy & form handling</summary>
      <p>
        {
          isUpwork
            ? "This route contains no contact form and stores no visitor information."
            : "Form submissions are stored securely to process your enquiry. You will only be contacted regarding your project request."
        }
      </p>
    </details>
    <p>© 2026 ER11 · Product / UX · Frontend · Go backend</p>
  </div>
</section>
