---
import ArrowIcon from "../arrow-icon/arrow-icon.astro";
import "./role-bands.module.css";

const roles = [
  {
    number: "01",
    name: "Product / UX",
    scope: "Decisions, flows, interface, scope",
    className: "product",
  },
  {
    number: "02",
    name: "Frontend",
    scope: "Architecture, accessibility, delivery",
    className: "frontend",
  },
  {
    number: "03",
    name: "Backend",
    scope: "Go services, data, reliability",
    className: "backend",
  },
];
---

<section
  class="role-bands"
  aria-label="One team, three accountable disciplines"
>
  {
    roles.map(({ number, name, scope, className }) => (
      <a
        class={`role-bands__item role-bands__item--${className}`}
        href="#team"
        data-role-band
      >
        <>
          <b>{number}</b>
          <span>{name}</span>
          <small>{scope}</small>
          <ArrowIcon />
        </>
      </a>
    ))
  }
</section>
