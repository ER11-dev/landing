---
import TechnologyTool from "./TechnologyTool.astro";

const lanes = [
  {
    number: "01",
    discipline: "Product / UX",
    summary: "Flows, systems, and a handoff engineers can trust.",
    className: "product",
    featured: ["Figma"],
    groups: [
      {
        tools: [
          {
            name: "Figma",
            role: "Product systems",
            logo: "https://svgl.app/library/figma.svg",
            width: 54,
            height: 80,
          },
        ],
      },
    ],
  },
  {
    number: "02",
    discipline: "Frontend",
    summary: "Typed interfaces with a production-ready delivery path.",
    className: "frontend",
    featured: ["TypeScript", "React", "Next.js"],
    groups: [
      {
        tools: [
          {
            name: "TypeScript",
            role: "Type safety",
            logo: "https://svgl.app/library/typescript.svg",
            width: 256,
            height: 256,
          },
          {
            name: "React",
            role: "Interface systems",
            logo: "https://svgl.app/library/react_light.svg",
            width: 569,
            height: 512,
          },
          {
            name: "Next.js",
            role: "Product delivery",
            logo: "https://svgl.app/library/nextjs_icon_dark.svg",
            width: 180,
            height: 180,
          },
          {
            name: "RxJS",
            role: "Reactive systems",
            logo: "https://svgl.app/library/rxjs.svg",
            width: 256,
            height: 256,
          },
          { name: "React Native", role: "Mobile products", mark: "RN" },
          {
            name: "TanStack",
            role: "Data & app tooling",
            logo: "https://svgl.app/library/tanstack.svg",
            width: 256,
            height: 256,
          },
          {
            name: "Playwright",
            role: "Browser testing",
            logo: "https://svgl.app/library/playwright.svg",
            width: 256,
            height: 256,
          },
          { name: "Astro JS", role: "Content delivery", mark: "A*" },
          {
            name: "Solid",
            role: "Reactive interfaces",
            logo: "https://svgl.app/library/solidjs.svg",
            width: 256,
            height: 256,
          },
        ],
      },
    ],
  },
  {
    number: "03",
    discipline: "Backend",
    summary: "Fast services, durable data, and observable runtime behavior.",
    className: "backend",
    featured: ["Go", "PostgreSQL", "Docker"],
    groups: [
      {
        name: "Languages",
        tools: [
          {
            name: "Go",
            role: "Service language",
            logo: "https://svgl.app/library/golang.svg",
            width: 207,
            height: 78,
          },
          {
            name: "JavaScript",
            role: "Runtime language",
            logo: "https://svgl.app/library/javascript.svg",
            width: 256,
            height: 256,
          },
          { name: "SQL", role: "Data language", mark: "SQL" },
        ],
      },
      {
        name: "Backend",
        tools: [
          { name: "gRPC", role: "Service contracts", mark: "gRPC" },
          { name: "Protobuf", role: "Typed schemas", mark: "PB" },
          { name: "REST", role: "Web APIs", mark: "REST" },
        ],
      },
      {
        name: "Messaging",
        tools: [
          { name: "NATS JetStream", role: "Event streaming", mark: "NATS" },
          { name: "RabbitMQ", role: "Message broker", mark: "RMQ" },
          { name: "Kafka", role: "Event backbone", mark: "K" },
        ],
      },
      {
        name: "Databases",
        tools: [
          {
            name: "PostgreSQL",
            role: "Relational data",
            logo: "https://svgl.app/library/postgresql.svg",
            width: 432,
            height: 445,
          },
          { name: "MongoDB", role: "Document data", mark: "M" },
          {
            name: "Redis",
            role: "Fast state",
            logo: "https://svgl.app/library/redis.svg",
            width: 256,
            height: 220,
          },
        ],
      },
      {
        name: "Cloud & DevOps",
        tools: [
          { name: "AWS", role: "ECS · EC2 · VPC", mark: "AWS" },
          {
            name: "Docker",
            role: "Repeatable runtime",
            logo: "https://svgl.app/library/docker.svg",
            width: 24,
            height: 24,
          },
          {
            name: "GitHub CI/CD",
            role: "Delivery pipelines",
            logo: "https://svgl.app/library/github_light.svg",
            width: 256,
            height: 256,
          },
          {
            name: "Cloudflare",
            role: "Workers · Caching",
            logo: "https://svgl.app/library/cloudflare.svg",
            width: 256,
            height: 256,
          },
          { name: "WireGuard", role: "Private networking", mark: "WG" },
        ],
      },
      {
        name: "Observability",
        tools: [
          { name: "Prometheus", role: "Metrics", mark: "P" },
          { name: "OpenTelemetry", role: "Traces & signals", mark: "OTel" },
          {
            name: "Grafana",
            role: "Dashboards",
            logo: "https://svgl.app/library/grafana.svg",
            width: 256,
            height: 256,
          },
        ],
      },
    ],
  },
];

const toolCount = lanes.reduce(
  (laneTotal, lane) =>
    laneTotal +
    lane.groups.reduce(
      (groupTotal, group) => groupTotal + group.tools.length,
      0,
    ),
  0,
);
---

<section
  class="technology-press"
  id="stack"
  aria-labelledby="technology-title"
  data-index-section
>
  <header class="technology-press__heading">
    <span class="technology-press__number">06</span>
    <h2 id="technology-title">A stack that survives the handoff.</h2>
    <p>
      These are the tools in our daily build loop—from editable product
      decisions to typed interfaces and dependable services. We preserve a sound
      existing stack instead of forcing a rewrite.
    </p>
  </header>

  <div class="technology-register">
    <div class="technology-register__meta">
      <span>ER11 / Technology register</span>
      <span>{String(toolCount).padStart(2, "0")} skills · 03 owners</span>
      <span>Choose for the product, not the trend</span>
    </div>

    {
      lanes.map(
        ({ number, discipline, summary, className, groups, featured }) => {
          const allTools = groups.flatMap((group) => group.tools);
          const featuredTools = featured
            .map((name) => allTools.find((tool) => tool.name === name))
            .filter(Boolean);
          const remainingGroups = groups
            .map((group) => ({
              ...group,
              tools: group.tools.filter(
                (tool) => !featured.includes(tool.name),
              ),
            }))
            .filter((group) => group.tools.length > 0);
          let toolIndex = featuredTools.length;

          return (
            <section
              class={`technology-lane technology-lane--${className}`}
              aria-labelledby={`technology-${className}`}
            >
              <header class="technology-lane__owner">
                <span>{number}</span>
                <div>
                  <h3 id={`technology-${className}`}>{discipline}</h3>
                  <p>{summary}</p>
                </div>
              </header>
              <div class="technology-lane__content">
                <div class="technology-lane__featured">
                  <ul style={`--tool-count:${featuredTools.length}`}>
                    {featuredTools.map((tool, index) => (
                      <TechnologyTool {tool} {number} {index} />
                    ))}
                  </ul>
                </div>

                {remainingGroups.length > 0 && (
                  <details class="technology-disclosure">
                    <summary>
                      <span>View full {discipline} register</span>
                      <span>
                        {String(allTools.length).padStart(2, "0")} skills
                      </span>
                      <i aria-hidden="true" />
                    </summary>
                    <div class="technology-disclosure__body">
                      <div class="technology-disclosure__inner">
                        <div class="technology-lane__groups">
                          {remainingGroups.map((group) => (
                            <section class="technology-group">
                              {group.name && <h4>{group.name}</h4>}
                              <ul
                                style={`--tool-count:${Math.min(group.tools.length, 3)}`}
                              >
                                {group.tools.map((tool) => {
                                  const index = toolIndex++;
                                  return (
                                    <TechnologyTool {tool} {number} {index} />
                                  );
                                })}
                              </ul>
                            </section>
                          ))}
                        </div>
                      </div>
                    </div>
                  </details>
                )}
              </div>
            </section>
          );
        },
      )
    }

    <footer class="technology-register__footer">
      <span>Product decision</span>
      <span class="technology-register__line" aria-hidden="true"></span>
      <span>Production runtime</span>
    </footer>
  </div>
</section>
