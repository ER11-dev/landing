---
const goodFit = [
  "You already have a working or rapidly assembled prototype.",
  "A real user flow now needs dependable product and engineering decisions.",
  "You want senior owners working directly, without a large agency relay.",
];

const poorFit = [
  "You need a claim-heavy pitch before sharing the actual product context.",
  "You want three isolated executors with no shared ownership.",
  "You need an unsupported guarantee, fixed result, or invented deadline.",
];
---

<section class="fit" aria-labelledby="fit-title">
  <div class="fit__masthead"><span>Fit check</span><h2 id="fit-title">Know the fit before the scope.</h2></div>
  <div class="fit-columns">
    <section class="fit-column fit-column--good">
      <header><b>01</b><h3>Likely a fit</h3></header>
      <ul>{goodFit.map((item, index) => <li><b>0{index + 1}</b><span>{item}</span></li>)}</ul>
    </section>
    <section class="fit-column fit-column--bad">
      <header><b>02</b><h3>Probably not</h3></header>
      <ul>{poorFit.map((item, index) => <li><b>0{index + 1}</b><span>{item}</span></li>)}</ul>
    </section>
  </div>
</section>
