---
import "./readiness.module.css";

const items = [
  {
    title: "Critical flows",
    copy: "Primary task, empty, loading, error, permission, and recovery states.",
    owner: "Product / UX",
    ownerClass: "product",
  },
  {
    title: "Frontend integrity",
    copy: "Architecture, responsive behavior, accessibility, performance, and maintainable state.",
    owner: "Frontend",
    ownerClass: "frontend",
  },
  {
    title: "Backend reliability",
    copy: "Data model, authorization, retries, observability, and operational failure modes.",
    owner: "Backend",
    ownerClass: "backend",
  },
  {
    title: "Release path",
    copy: "Scope, acceptance criteria, quality checks, handoff, and the next informed decision.",
    owner: "All three",
    ownerClass: "all",
  },
];
---

<section
  class="readiness"
  id="readiness"
  aria-labelledby="readiness-title"
  data-index-section
>
  <div class="section-heading section-heading--compact">
    <span class="section-heading__number">03</span>
    <h2 id="readiness-title">
      The gap is rarely “more code.” It is unresolved product risk.
    </h2>
  </div>
  <div class="readiness__body">
    <figure class="readiness__art">
      <img
        src="/graphics/risk-exploded.webp"
        alt="An exploded stack of product layers exposing hidden pathways, evidence tags, and release risks."
        width="1024"
        height="1536"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Inspect the system between the visible interface and the release.
      </figcaption>
    </figure>
    <div class="readiness__ledger">
      <div class="readiness__ledger-head">
        <span>Proof item</span><span>What we inspect</span><span>Owner</span>
      </div>
      {
        items.map(({ title, copy, owner, ownerClass }) => (
          <article>
            <>
              <b>{title}</b>
              <p>{copy}</p>
              <span class={`readiness__owner readiness__owner--${ownerClass}`}>
                {owner}
              </span>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
