---
import ArrowIcon from "./ArrowIcon.astro";

const offers = [
  {
    number: "01",
    type: "Diagnostic",
    title: "Production Readiness Sprint",
    copy: "Use it before committing a build budget: turn a working demo into a prioritized, owned release plan.",
    items: [
      "Critical-flow review",
      "Risk and dependency register",
      "Sequenced delivery decision",
    ],
    className: "offer-row--magenta",
  },
  {
    number: "02",
    type: "Build",
    title: "Critical Flow to Production",
    copy: "Use it when one user journey matters more than a broad rewrite: harden that path into a dependable release.",
    items: [
      "Defined states and acceptance criteria",
      "Frontend implementation",
      "Backend path where required",
    ],
    className: "offer-row--cyan",
  },
  {
    number: "03",
    type: "Continue",
    title: "Product Continuity",
    copy: "Use it after the first proof: keep product decisions, interface work, and backend delivery moving together.",
    items: [
      "Owned product backlog",
      "Incremental releases",
      "Visible verification evidence",
    ],
    className: "offer-row--yellow",
  },
];

interface Props {
  actionHref?: string;
  actionLabel?: string;
}

const { actionHref = "#contact", actionLabel = "Discuss this scope" } =
  Astro.props;
---

<section
  class="offers"
  id="offers"
  aria-labelledby="offers-title"
  data-index-section
>
  <div class="offers__masthead">
    <span class="offers__number">04</span>
    <h2 id="offers-title">Choose the first proof, not the whole roadmap.</h2>
    <p>
      Start with the smallest scope that can replace uncertainty with evidence.
    </p>
  </div>
  <figure class="offers-art">
    <img
      src="/graphics/scope-tickets.webp"
      alt="Three interlocking CMY production tickets joined by one continuous delivery route."
      width="1823"
      height="863"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="scope-docket">
    {
      offers.map(({ number, type, title, copy, items, className }) => (
        <article class:list={["offer-row", className]}>
          <header class="offer-row__index">
            <>
              <b>{number}</b>
              <span>{type}</span>
            </>
          </header>
          <div class="offer-row__body">
            <>
              <h3>{title}</h3>
              <p>{copy}</p>
            </>
          </div>
          <ul class="offer-row__evidence">
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="offer-row__action" href={actionHref}>
            {actionLabel} <ArrowIcon />
          </a>
        </article>
      ))
    }
  </div>
</section>
