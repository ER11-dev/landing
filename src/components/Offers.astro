---
import ArrowIcon from "./ArrowIcon.astro";

const offers = [
  {
    number: "01",
    type: "Diagnostic",
    title: "Production Readiness Sprint",
    copy: "Turn a working demo into a prioritized, owned plan for production.",
    items: ["Critical-flow review", "UX and architecture risks", "Sequenced delivery plan"],
    className: "offer-row--magenta",
  },
  {
    number: "02",
    type: "Build",
    title: "Critical Flow to Production",
    copy: "Take one valuable user journey from fragile prototype to dependable release.",
    items: ["Product decisions and UX", "Frontend implementation", "Backend path where needed"],
    className: "offer-row--cyan",
  },
  {
    number: "03",
    type: "Continue",
    title: "Product Continuity",
    copy: "Keep decisions, interface work, and backend delivery moving as one system.",
    items: ["Shared product backlog", "Continuous delivery", "Visible release evidence"],
    className: "offer-row--yellow",
  },
];
---

<section class="offers" id="offers" aria-labelledby="offers-title" data-index-section>
  <div class="offers__masthead">
    <span class="offers__number">04</span>
    <h2 id="offers-title">Choose the first proof, not the whole roadmap.</h2>
    <p>Start with the smallest scope that can replace uncertainty with evidence.</p>
  </div>
  <figure class="offers-art">
    <img
      src="/graphics/scope-tickets.webp"
      alt="Three interlocking CMY production tickets joined by one continuous delivery route."
      width="1823"
      height="863"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="scope-docket">
    {offers.map(({ number, type, title, copy, items, className }) => (
      <article class:list={["offer-row", className]}>
        <header class="offer-row__index"><b>{number}</b><span>{type}</span></header>
        <div class="offer-row__body"><h3>{title}</h3><p>{copy}</p></div>
        <ul class="offer-row__evidence">{items.map((item) => <li>{item}</li>)}</ul>
        <a class="offer-row__action" href="#upwork">Discuss scope <ArrowIcon /></a>
      </article>
    ))}
  </div>
</section>
