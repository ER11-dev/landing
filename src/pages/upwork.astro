---
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/landing/landing.astro";
import { loadLandingProjects, readContentSiteKey } from "../lib/content";

export const prerender = false;

const title = "ER11 — Product delivery team on Upwork";
const description =
  "A contact-safe proof layer for prospects evaluating ER11 through Upwork.";
const projects = await loadLandingProjects({
  siteKey: readContentSiteKey(),
  channel: "upwork",
});
---

<BaseLayout {title} {description}>
  <Landing {projects} upworkSafe />
</BaseLayout>
