---
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/landing/landing.astro";
import { loadLandingProjects, readContentSiteKey } from "../lib/content";

export const prerender = false;

const title = "ER11 — From working prototype to production-ready product";
const description =
  "A compact senior product team for turning working B2B prototypes into dependable products for real users.";
const projects = await loadLandingProjects({
  siteKey: readContentSiteKey(),
  channel: "direct",
});
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ER11",
  url: "https://er11-dev.vercel.app",
  logo: "https://er11-dev.vercel.app/er11-logo.svg",
  description,
  sameAs: [],
};
---

<BaseLayout {title} {description} {jsonLd}>
  <Landing {projects} />
</BaseLayout>
