---
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/landing/landing.astro";
import { loadLandingProjects } from "../lib/content";

const title = "ER11 — From working prototype to production-ready product";
const description =
  "A compact senior product team for turning working B2B prototypes into dependable products for real users.";
const projects = loadLandingProjects({ channel: "direct" });
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "ER11",
  url: "https://er11-dev.vercel.app",
  logo: "https://er11-dev.vercel.app/er11-logo.svg",
  description,
  serviceType: [
    "Product Strategy",
    "UX/UI Design",
    "Frontend Engineering",
    "Go Backend Development",
  ],
  areaServed: "Worldwide",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Product Delivery Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Production Readiness Sprint",
          description:
            "Turn a working demo into a prioritized, owned release plan.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Critical Flow to Production",
          description:
            "Harden one user journey into a dependable production release.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Product Continuity",
          description:
            "Keep product decisions, interface work, and backend delivery moving together.",
        },
      },
    ],
  },
  sameAs: ["https://github.com/ER11-dev"],
};
---

<BaseLayout {title} {description} {jsonLd}>
  <Landing {projects} />
</BaseLayout>
