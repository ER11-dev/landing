---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectList from "../../components/project-list/project-list.astro";
import { loadLandingProjects } from "../../lib/content";

const projects = loadLandingProjects({ channel: "direct" });

const title = "Case studies — ER11";
const description =
  "A collection of Product / UX work spanning fintech, B2B CRM, and agency collaborations.";
const bodyClass = "project-theme";
const designContract = `
THESIS: All case studies presented as structured project records with cover imagery and consistent formatting.
OWN-WORLD: Warm proof paper, registration ink, project accent colors, square ruled sheets.
STORY: The visitor browses all projects, selects one to inspect, and follows the structured case study through problem, research, and solution.
FORM: Case study index page, production calibration strip.
`;
---

<BaseLayout
  {title}
  {description}
  {bodyClass}
  designContract={designContract}
  ogType="website"
>
  <ProjectList {projects} channel="direct" />
</BaseLayout>
